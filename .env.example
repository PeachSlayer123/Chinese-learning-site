# Kopieer naar .env en vul in. Commit .env nooit!
ANTHROPIC_API_KEY=

# Optioneel (dit zijn de standaardwaarden):
# CLAUDE_MODEL=claude-haiku-4-5            # dictees maken
# CLAUDE_MODEL_HERKENNING=claude-opus-5-5   # woordenlijst lezen uit een screenshot
# DATABASE_PATH=data/app.db
# ZINNEN_BRONNEN=tatoeba,ollama,claude      # volgorde: Tatoeba, dan lokale AI, dan Claude
# OLLAMA_URL=http://100.79.121.108:11434    # leeg = geen lokale AI (desktop via Tailscale)
# OLLAMA_MODEL=qwen3.5:9b
# WOL_MAC=9C:6B:00:21:8E:AE                 # desktop wekken als Ollama niet antwoordt (leeg = niet wekken)
# WOL_BROADCAST=192.168.1.255
# OLLAMA_WEKTIJD=120                        # max. seconden wachten tot de gewekte pc antwoordt
# TATOEBA_PAD=backend/app/data/tatoeba_cmn.tsv.gz
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
